<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" compressed="false">
  <diagram id="linaje-cima" name="Linaje de datos CIMA">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="El dato nace en admisión y recursos y fluye F2 → F3 → F4" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#1f2a33;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="720" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Recordatorio, Portal y reporte son salidas; los ajustes del plan vuelven a CU-06" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#5b6670;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="720" height="22" as="geometry" />
        </mxCell>

        <mxCell id="f1" value="&lt;b&gt;F1 Admisiones (CU-01 a CU-04)&lt;/b&gt;&lt;br&gt;Solicitud de Atención → Cita (entrevista)&lt;br&gt;Paciente · Evaluación Externa · Documento Previo&lt;br&gt;Institución Educativa · Docente&lt;br&gt;Representante · Consentimiento (2 tipos)&lt;br&gt;Expediente Clínico → Cuenta de Acceso" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontFamily=Arial;fontSize=12;fontColor=#1f2a33;strokeColor=#8a959e;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="72" y="88" width="320" height="136" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;S1 Recursos (CU-13 y CU-14)&lt;/b&gt;&lt;br&gt;Profesional (especialidad, rol)&lt;br&gt;Espacio · Material Didáctico&lt;br&gt;Disponibilidad (profesional y espacio)&lt;br&gt;Préstamo de Material Didáctico" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontFamily=Arial;fontSize=12;fontColor=#1f2a33;strokeColor=#8a959e;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="472" y="88" width="320" height="136" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;F2 Planes (CU-05 a CU-07)&lt;/b&gt;&lt;br&gt;Propuesta (LLM + RAG, revisión profesional)&lt;br&gt;Plan de Intervención (estado, aprobación)&lt;br&gt;Área de Intervención → Terapeuta asignado&lt;br&gt;objetivos, línea base, Actividad Terapéutica&lt;br&gt;Horario Terapéutico (día, hora, espacio)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontFamily=Arial;fontSize=12;fontColor=#1f2a33;strokeColor=#8a959e;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="72" y="288" width="320" height="136" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;S2 Pagos (CU-15 y CU-16)&lt;/b&gt;&lt;br&gt;Paciente (cédula) desde F1 · Pagador&lt;br&gt;Pago (PAG-001) · Comprobante de Pago&lt;br&gt;Reporte mensual Excel/CSV → contadora&lt;br&gt;Saldos pendientes por mes" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontFamily=Arial;fontSize=12;fontColor=#1f2a33;strokeColor=#8a959e;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="472" y="288" width="320" height="136" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;F3 Sesiones (CU-08 a CU-10)&lt;/b&gt;&lt;br&gt;Sesión: asistencia, objetivos, desempeño&lt;br&gt;Incidente → aviso a la Coordinadora&lt;br&gt;Tarea en casa → Representante&lt;br&gt;Recomendación → Docente&lt;br&gt;Adaptación Curricular; Informe a Institución" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontFamily=Arial;fontSize=12;fontColor=#1f2a33;strokeColor=#8a959e;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="72" y="488" width="320" height="136" as="geometry" />
        </mxCell>
        <mxCell id="rec" value="&lt;b&gt;§8.1 Recordatorio (salida)&lt;/b&gt;&lt;br&gt;Generado por Cita, Horario Terapéutico,&lt;br&gt;Sesión reprogramada y Estudio de Caso&lt;br&gt;Temporizador → Servicio de notificaciones&lt;br&gt;WhatsApp sin datos clínicos&lt;br&gt;estado: enviado o fallido" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontFamily=Arial;fontSize=12;fontColor=#1f2a33;strokeColor=#8a959e;fillColor=#eeefec;" vertex="1" parent="1">
          <mxGeometry x="472" y="488" width="320" height="136" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="&lt;b&gt;F4 Seguimiento (CU-11 y CU-12)&lt;/b&gt;&lt;br&gt;Estudio de Caso (acuerdos) · Nota&lt;br&gt;Cumplimiento por objetivo específico&lt;br&gt;Informe de avance → Representante&lt;br&gt;Alta → Informe de alta&lt;br&gt;Cierre del Expediente (alta general)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontFamily=Arial;fontSize=12;fontColor=#1f2a33;strokeColor=#8a959e;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="72" y="688" width="320" height="136" as="geometry" />
        </mxCell>
        <mxCell id="portal" value="&lt;b&gt;Portal del representante (salida)&lt;/b&gt;&lt;br&gt;Cuenta de Acceso (usuario y contraseña)&lt;br&gt;Consentimientos · Plan aprobado · Horario&lt;br&gt;Tareas · Informes de avance y de alta&lt;br&gt;Pagos realizados&lt;br&gt;Sin notas, acuerdos ni Propuestas de IA" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontFamily=Arial;fontSize=12;fontColor=#1f2a33;strokeColor=#8a959e;fillColor=#eeefec;" vertex="1" parent="1">
          <mxGeometry x="472" y="688" width="320" height="136" as="geometry" />
        </mxCell>

